FROM supabase/studio:latest

# Replace hardcoded Kong gateway URL in compiled JS and .env file
RUN find /app -name "*.js" -type f | xargs grep -l "localhost:8000" 2>/dev/null | \
    xargs -r sed -i \
      -e 's|http://localhost:8000|https://storage.vps.buyticle.com|g' \
      -e 's|"localhost:8000"|"storage.vps.buyticle.com"|g' || true

RUN sed -i \
      -e 's|SUPABASE_URL=http://localhost:8000|SUPABASE_URL=https://storage.vps.buyticle.com|g' \
      -e 's|SUPABASE_PUBLIC_URL=http://localhost:8000|SUPABASE_PUBLIC_URL=https://storage.vps.buyticle.com|g' \
      -e 's|STUDIO_PG_META_URL=.*|STUDIO_PG_META_URL=http://meta:8080|g' \
      -e 's|SUPABASE_ANON_KEY=.*|SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlhdCI6MTYxMzUzMTk4NSwiZXhwIjoxOTI5MTA3OTg1fQ.Zh6_Tis6i9tJ0pUUhjEgS8Z6JoCxxxIoNSYztm0Zsec|g' \
      -e 's|SUPABASE_SERVICE_KEY=.*|SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjEzNTMxOTg1LCJleHAiOjE5MjkxMDc5ODV9.1olGuGrVqAzTirqYD_fG65VOcu7sUUYaK2Mmx7YU1yA|g' \
      -e 's|STORAGE_URL=.*|STORAGE_URL=http://storage:5000|g' \
      /app/apps/studio/.env 2>/dev/null || true

ENV STUDIO_PG_META_URL=http://meta:8080
ENV SUPABASE_URL=https://storage.vps.buyticle.com
ENV SUPABASE_REST_URL=https://rest.vps.buyticle.com
ENV STORAGE_URL=http://storage:5000
ENV NEXT_PUBLIC_STORAGE_URL=https://storage.vps.buyticle.com
ENV NEXT_PUBLIC_STORAGE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjEzNTMxOTg1LCJleHAiOjE5MjkxMDc5ODV9.1olGuGrVqAzTirqYD_fG65VOcu7sUUYaK2Mmx7YU1yA
ENV SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlhdCI6MTYxMzUzMTk4NSwiZXhwIjoxOTI5MTA3OTg1fQ.Zh6_Tis6i9tJ0pUUhjEgS8Z6JoCxxxIoNSYztm0Zsec
ENV SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjEzNTMxOTg1LCJleHAiOjE5MjkxMDc5ODV9.1olGuGrVqAzTirqYD_fG65VOcu7sUUYaK2Mmx7YU1yA
ENV SUPABASE_INTERNAL_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjEzNTMxOTg1LCJleHAiOjE5MjkxMDc5ODV9.1olGuGrVqAzTirqYD_fG65VOcu7sUUYaK2Mmx7YU1yA
ENV STUDIO_DEFAULT_ORGANIZATION=Buyticle
ENV STUDIO_DEFAULT_PROJECT=Inventaire
ENV POSTGRES_PASSWORD=buyticle
ENV SUPABASE_FUNCTIONS_URL=""
ENV EDGE_FUNCTIONS_MANAGEMENT_FOLDER=/tmp/functions
ENV IS_PLATFORM=false
ENV PORT=3000
